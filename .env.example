# Örnek ortam değişkenleri. Kopyalayıp .env.local yapın ve değerleri doldurun; .env ve .env.local Git'e eklenmez.
# Vercel'de aynı adlarla Project Settings > Environment Variables'a girilir.

# Supabase (Feyza'nın projesi, herkese açık anahtar)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# İsteğe bağlı, yalnız sunucuda: öneri gönderildiği anda YZ analizini arka planda başlatmak için.
# Boşsa analiz, editör "Onay bekleyenler" sayfasını açınca yapılır.
SUPABASE_SERVICE_ROLE_KEY=

# Yönetim paneli (yalnız geliştirmede tek şifreli giriş)
VAKFIYE_YONETIM_SIFRESI=

# Yapay zekâ
# Yönetim panelindeki YZ özelliklerinin tamamı (kaynak analizi, öneri ön eleme): true değilse kapalı.
AI_ENABLED=false
# Günlük toplam YZ çağrısı üst sınırı.
YZ_GUNLUK_LIMIT=200
# Google AI Studio'nun ücretsiz anahtarı (asistan ve panel YZ'si).
GEMINI_API_KEY=
# İsteğe bağlı model adları (varsayılan: gemini-flash-lite-latest, yedek gemini-flash-latest)
GEMINI_MODEL=
GEMINI_YEDEK_MODEL=
# İsteğe bağlı: ziyaretçi asistanı için Claude (ücretli)
ANTHROPIC_API_KEY=
